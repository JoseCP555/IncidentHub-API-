{
  "name": "incidenthub-api",
  "version": "1.0.0",
  "description": "IncidentHub API v1 - API REST para la gestión de incidentes tecnológicos (Node.js + TypeScript + Express 5)",
  "main": "dist/server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-reporter=spec tests/incidents.api.test.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "rest-api",
    "incidents"
  ],
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
